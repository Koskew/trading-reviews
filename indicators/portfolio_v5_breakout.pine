//@version=5
// ═══════════════════════════════════════════════════════════════════
// ПОРТФЕЛЬ: v5 (разворот) + ПРОБОЙ (импульс) — то, что прошло проверки.
// Обе системы от жёлтой свечи, противоположной логики; недельная
// корреляция R = +0.02 (почти независимы) → портфель глаже каждой.
// Золото 1H 2017-2026: вместе +311R, 8/10 лет плюс (engine/transfer_check).
//
// A — v5 (разворот, повердиктно сверена): каскад меток → разворотный вход,
//     тейк-магнит RR>=3, стоп за свечой ±0.1%. Правила из walk-forward:
//     недельный предохранитель -3R + фильтр БОК+LONG (не лонговать боковик).
// B — ПРОБОЙ (импульс, OOS test +116R): жёлтая свеча → стоп-ордера за
//     high/low, окно 3 бара, тейк 2.5R, сессия 08-20 UTC, предохранитель -3R.
//
// ЧЕСТНО: оба эджа тонкие, портфель не убирает 2024 полностью, числа
// повторятся близко но не бит-в-бит (фиды ~2-3пт). Инструмент НАБЛЮДЕНИЯ.
// ═══════════════════════════════════════════════════════════════════
indicator("Портфель: v5 + Пробой", overlay=true, max_lines_count=500, max_labels_count=500)

// ════════ НАСТРОЙКИ ════════
g0 = "🎛 Системы"
show_v5 = input.bool(true, "Система A: v5 (разворот)", group=g0)
show_bo = input.bool(true, "Система B: Пробой (импульс)", group=g0)
tol     = input.float(4.0, "Допуск формы свечи ±%", minval=1.0, maxval=15.0, group=g0)

g1 = "🤖 v5 (разворот)"
v5_thr   = input.float(0.317, "Порог размера свечи, %", step=0.001, group=g1)
v5_rrmin = input.float(3.0, "Мин. RR магнита", minval=0.5, step=0.5, group=g1)
v5_buf   = input.float(0.1, "Буфер стопа, %", minval=0.0, step=0.05, group=g1)
v5_ws    = input.bool(true, "Недельный предохранитель -3R (WF)", group=g1)
v5_regf  = input.bool(true, "Фильтр БОК+LONG (WF +26R OOS)", group=g1)

g2 = "🚀 Пробой (импульс)"
bo_W   = input.int(3, "Окно пробоя, баров", minval=1, maxval=10, group=g2)
bo_k   = input.float(2.5, "Тейк, R", minval=1.0, step=0.5, group=g2)
bo_buf = input.float(0.1, "Буфер стопа, %", minval=0.0, step=0.05, group=g2)
bo_sa  = input.int(8, "Сессия с (час UTC)", minval=0, maxval=23, group=g2)
bo_sb  = input.int(20, "Сессия по (час UTC)", minval=0, maxval=23, group=g2)
bo_ws  = input.bool(true, "Недельный предохранитель -3R", group=g2)

g3 = "🎨 Отображение"
show_dots = input.bool(true, "Жёлтые точки (контекст)", group=g3)
show_ln   = input.bool(true, "Линии сделок", group=g3)
draw_bars = input.int(4000, "Рисовать за последние N баров", minval=100, group=g3)
tbl_pos   = input.string("верх-право", "Таблица", options=["верх-право","верх-лево","низ-право","низ-лево"], group=g3)

in_win  = last_bar_index - bar_index <= draw_bars
hutc    = hour(time, "Etc/UTC")
wk_id   = year(time, "Etc/UTC") * 100 + weekofyear(time, "Etc/UTC")

// ════════ ЖЁЛТАЯ СВЕЧА ════════
rng_ = high - low
bp = rng_ > 0 ? math.abs(close - open) / rng_ * 100 : 0.0
up_ = rng_ > 0 ? (open > close ? high - open : high - close) / rng_ * 100 : 0.0
lo_ = rng_ > 0 ? (open > close ? close - low : open - low) / rng_ * 100 : 0.0
tb = array.from(12.6,14.7,17.0,32.0,20.2,4.1,23.0,27.9,30.7,35.2,24.5,41.9,26.0,25.9,11.6,23.3,49.3,14.0,18.3,25.4,27.9,45.7,29.2,40.6,41.9,10.4,41.5,23.6,32.2,18.8,35.5,32.2,54.2,10.8,47.3,16.0,21.6,19.8,9.9,27.5)
tu = array.from(33.7,37.3,37.7,27.8,29.4,40.4,35.7,35.3,41.0,35.7,28.4,22.0,39.6,37.4,46.0,31.5,21.5,27.5,47.3,35.6,26.2,24.8,36.3,36.7,26.8,35.6,20.7,34.5,36.4,46.2,38.6,33.6,21.6,44.1,22.9,45.2,42.8,45.2,41.5,30.7)
tl = array.from(53.7,48.0,45.3,40.2,50.4,55.5,41.3,36.8,28.3,29.1,71.6,36.0,34.5,36.7,42.5,45.2,29.2,58.5,34.4,39.0,46.0,29.5,34.5,22.6,31.3,54.0,37.9,41.9,31.4,34.9,25.8,34.2,24.2,45.1,29.8,38.8,35.5,35.0,48.6,41.8)
shape_ok = false
for i = 0 to 39
    if math.abs(bp - array.get(tb, i)) <= tol and math.abs(up_ - array.get(tu, i)) <= tol and math.abs(lo_ - array.get(tl, i)) <= tol
        shape_ok := true
        break

// ════════ ПИВОТЫ 2/2 + МЕТКИ (для v5) ════════
ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow(low, 2, 2)
phv = high[2]
plv = low[2]
vw1 = ta.valuewhen(not na(ph), phv, 1)
vw2 = ta.valuewhen(not na(ph), phv, 0)
hh = na(ph) ? na : vw1 < vw2 ? ph : na
lh = na(ph) ? na : vw1 > vw2 ? ph : na
vw3 = ta.valuewhen(not na(pl), plv, 1)
vw4 = ta.valuewhen(not na(pl), plv, 0)
hl = na(pl) ? na : vw3 < vw4 ? pl : na
ll = na(pl) ? na : vw3 > vw4 ? pl : na

var string[] qL = array.new_string()
var float[]  qP = array.new_float()
var string[] qS = array.new_string()
var int[]    qC = array.new_int()

push(_l, _p, _s) =>
    array.push(qL, _l)
    array.push(qP, _p)
    array.push(qS, _s)
    array.push(qC, bar_index)
    if array.size(qL) > 5
        array.shift(qL)
        array.shift(qP)
        array.shift(qS)
        array.shift(qC)

nH = not na(hh) or not na(lh)
nL = not na(hl) or not na(ll)
if nH and nL
    push(not na(hh) ? "HH" : "LH", phv, "high")
    push(not na(hl) ? "HL" : "LL", plv, "low")
else if nH
    push(not na(hh) ? "HH" : "LH", phv, "high")
else if nL
    push(not na(hl) ? "HL" : "LL", plv, "low")

// ════════ МЕДЛЕННЫЕ 5/5 + D3 (для фильтра БОК+LONG) ════════
ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow(low, 5, 5)
p5h = high[5]
p5l = low[5]
u1 = ta.valuewhen(not na(ph5), p5h, 1)
u2 = ta.valuewhen(not na(ph5), p5h, 0)
hh5 = na(ph5) ? na : u1 < u2 ? ph5 : na
lh5 = na(ph5) ? na : u1 > u2 ? ph5 : na
u3 = ta.valuewhen(not na(pl5), p5l, 1)
u4 = ta.valuewhen(not na(pl5), p5l, 0)
hl5 = na(pl5) ? na : u3 < u4 ? pl5 : na
ll5 = na(pl5) ? na : u3 > u4 ? pl5 : na

var int    d3 = 0
var float  d3lvl = na
var string sH = ""
var string sL = ""
var float  sHp = na
var float  sLp = na
if barstate.isconfirmed
    if not na(hh5) or not na(lh5)
        sH := not na(hh5) ? "HH" : "LH"
        sHp := not na(hh5) ? hh5 : lh5
        if d3 == -1 and sH == "LH"
            d3lvl := sHp
    if not na(hl5) or not na(ll5)
        sL := not na(hl5) ? "HL" : "LL"
        sLp := not na(hl5) ? hl5 : ll5
        if d3 == 1 and sL == "HL"
            d3lvl := sLp
    if d3 == 0
        if sH == "HH" and sL == "HL"
            d3 := 1
            d3lvl := sLp
        else if sH == "LH" and sL == "LL"
            d3 := -1
            d3lvl := sHp
    if d3 == 1 and not na(d3lvl) and math.min(open, close) < d3lvl
        d3 := 0
        d3lvl := na
    else if d3 == -1 and not na(d3lvl) and math.max(open, close) > d3lvl
        d3 := 0
        d3lvl := na

// ════════ ПОРОГ / ХВОСТ ════════
sz_big() =>
    (high - low) / close * 100 > v5_thr

f_tail(_n) =>
    n = array.size(qL)
    m = math.min(_n, n)
    s = ""
    if m > 0
        for j = n - m to n - 1
            s := s + (j > n - m ? ">" : "") + array.get(qL, j)
    s

// ════════ ПОЗИЦИИ И R (A = v5, B = пробой) ════════
var bool[]  AL = array.new_bool()
var float[] AE = array.new_float()
var float[] AS = array.new_float()
var float[] AT = array.new_float()
var int[]   AB = array.new_int()
var bool[]  BL = array.new_bool()
var float[] BE = array.new_float()
var float[] BS = array.new_float()
var float[] BT = array.new_float()
var int[]   BB = array.new_int()
var float[] Arv = array.new_float()
var int[]   Art = array.new_int()
var float[] Brv = array.new_float()
var int[]   Brt = array.new_int()
var int   Awk = -1
var float Awr = 0.0
var int   Bwk = -1
var float Bwr = 0.0

if barstate.isconfirmed and wk_id != Awk
    Awk := wk_id
    Awr := 0.0
if barstate.isconfirmed and wk_id != Bwk
    Bwk := wk_id
    Bwr := 0.0

// резолв набора позиций: закрывает по SL/TP, пишет R, возвращает недельный R-дельту
f_resolve(_L, _E, _S, _T, _B, _Rv, _Rt, _colHit) =>
    wkR = 0.0
    k = 0
    while k < array.size(_E)
        closed = false
        if bar_index > array.get(_B, k) and barstate.isconfirmed
            lng = array.get(_L, k)
            sl = array.get(_S, k)
            tp = array.get(_T, k)
            en = array.get(_E, k)
            hs = lng ? low <= sl : high >= sl
            ht = lng ? high >= tp : low <= tp
            if hs or ht
                r = hs ? -1.0 : math.abs(tp - en) / math.abs(en - sl)
                array.push(_Rv, r)
                array.push(_Rt, time)
                wkR += r
                if show_ln and in_win
                    label.new(bar_index, hs ? sl : tp, hs ? "sl" : "tp", style=hs ? label.style_label_up : label.style_label_down, color=color.new(_colHit, 20), textcolor=color.white, size=size.tiny)
                array.remove(_L, k)
                array.remove(_E, k)
                array.remove(_S, k)
                array.remove(_T, k)
                array.remove(_B, k)
                closed := true
        if not closed
            k += 1
    wkR

Awr += f_resolve(AL, AE, AS, AT, AB, Arv, Art, color.red)
Bwr += f_resolve(BL, BE, BS, BT, BB, Brv, Brt, color.orange)

// ════════ СИСТЕМА A — v5 РЕШЕНИЕ ════════
f_v5() =>
    string vd = ""
    string dd = ""
    float en = na
    float sl = na
    float tp = na
    n = array.size(qL)
    if n > 0
        lastL = array.get(qL, n - 1)
        is_long = lastL == "HL" or lastL == "LL"
        dd := is_long ? "LONG" : "SHORT"
        lag = bar_index - array.get(qC, n - 1)
        up = 0
        dn = 0
        for j = 0 to n - 1
            lb = array.get(qL, j)
            up += lb == "HH" or lb == "HL" ? 1 : 0
            dn += lb == "LH" or lb == "LL" ? 1 : 0
        had = false
        if n >= 2
            for j = 1 to n - 1
                a = array.get(qL, j - 1)
                b = array.get(qL, j)
                if (a == "HH" and b == "LL") or (a == "LL" and b == "HL")
                    had := true
        prevL = n >= 2 ? array.get(qL, n - 2) : ""
        fresh = (prevL == "HH" and lastL == "LL") or (prevL == "LL" and lastL == "HL")
        if (lastL == "LL" or lastL == "HH") and lag <= 1
            vd := "заморозка"
        else if sz_big()
            vd := "бол.свеча"
        else if not had and not is_long and up >= (lastL == "HH" ? 3 : 4)
            vd := "против тренда"
        else if not had and is_long and dn >= 4
            vd := "против тренда"
        else if fresh
            vd := "слом"
        else
            en := close
            sl := is_long ? low * (1 - v5_buf / 100) : high * (1 + v5_buf / 100)
            if (is_long and sl >= en) or (not is_long and sl <= en)
                vd := "стоп?"
            else
                risk = math.abs(en - sl)
                float[] cp = array.new_float()
                for j = 0 to n - 1
                    if array.get(qS, j) == (is_long ? "high" : "low")
                        p = array.get(qP, j)
                        if (is_long and p > en) or (not is_long and p < en)
                            array.push(cp, p)
                if array.size(cp) > 0
                    array.sort(cp, is_long ? order.ascending : order.descending)
                    for j = 0 to array.size(cp) - 1
                        p = array.get(cp, j)
                        if math.abs(p - en) / risk >= v5_rrmin
                            tp := p
                            break
                if na(tp)
                    vd := "нет RR"
                else
                    s5 = f_tail(5)
                    vd := str.endswith(s5, "LL>HH") or str.endswith(s5, "HH>LH") or str.endswith(s5, "LL>LH>HL") or str.endswith(s5, "HH>LL>LL") ? "запрет" : "ВХОД"
    [vd, dd, en, sl, tp]

string a_vd = na
string a_dd = na
float a_en = na
float a_sl = na
float a_tp = na
if show_v5 and shape_ok and barstate.isconfirmed
    if v5_ws and Awr <= -3.0
        a_vd := "стоп-неделя"
    else
        [x1, x2, x3, x4, x5] = f_v5()
        a_vd := x1
        a_dd := x2
        a_en := x3
        a_sl := x4
        a_tp := x5
        if v5_regf and a_vd == "ВХОД" and a_dd == "LONG" and d3 == 0
            a_vd := "БОК+LONG"

a_entry = a_vd == "ВХОД"
if a_entry
    array.push(AL, a_dd == "LONG")
    array.push(AE, a_en)
    array.push(AS, a_sl)
    array.push(AT, a_tp)
    array.push(AB, bar_index)
    if show_ln and in_win
        line.new(bar_index, a_en, bar_index + 1, a_en, color=color.new(color.blue, 0), width=1)
        line.new(bar_index, a_sl, bar_index + 2, a_sl, color=color.new(color.red, 55), style=line.style_dotted)
        line.new(bar_index, a_tp, bar_index + 2, a_tp, color=color.new(color.green, 55), style=line.style_dotted)

plotshape(show_v5 and a_entry and a_dd == "LONG", title="v5 LONG", style=shape.triangleup, location=location.belowbar, color=color.new(color.blue, 0), size=size.small)
plotshape(show_v5 and a_entry and a_dd == "SHORT", title="v5 SHORT", style=shape.triangledown, location=location.abovebar, color=color.new(color.navy, 0), size=size.small)

// ════════ СИСТЕМА B — ПРОБОЙ ════════
var bool  bo_pend = false
var float bo_hi = na
var float bo_lo = na
var int   bo_until = na
bo_sess = hutc >= bo_sa and hutc <= bo_sb
string b_evt = na
if show_bo and barstate.isconfirmed
    blocked = bo_ws and Bwr <= -3.0
    if bo_pend and array.size(BE) == 0 and not blocked
        if bar_index > bo_until
            bo_pend := false
        else
            u = high >= bo_hi
            d = low <= bo_lo
            if u and d
                bo_pend := false
            else if u or d
                en = u ? math.max(open, bo_hi) : math.min(open, bo_lo)
                sl = u ? bo_lo * (1 - bo_buf / 100) : bo_hi * (1 + bo_buf / 100)
                risk = math.abs(en - sl)
                tp = u ? en + bo_k * risk : en - bo_k * risk
                bo_pend := false
                array.push(BL, u)
                array.push(BE, en)
                array.push(BS, sl)
                array.push(BT, tp)
                array.push(BB, bar_index)
                b_evt := u ? "LONG" : "SHORT"
                if show_ln and in_win
                    line.new(bar_index, en, bar_index + 1, en, color=color.new(color.teal, 0), width=1)
    if shape_ok and array.size(BE) == 0 and not blocked and bo_sess
        bo_hi := high
        bo_lo := low
        bo_until := bar_index + bo_W
        bo_pend := true

plotshape(show_bo and b_evt == "LONG", title="Пробой LONG", style=shape.diamond, location=location.belowbar, color=color.new(color.teal, 0), size=size.tiny)
plotshape(show_bo and b_evt == "SHORT", title="Пробой SHORT", style=shape.diamond, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)

var line boH = na
var line boL = na
if show_bo and bo_pend and array.size(BE) == 0
    if na(boH)
        boH := line.new(bar_index, bo_hi, bar_index + 1, bo_hi, color=color.new(color.teal, 30), style=line.style_dashed)
        boL := line.new(bar_index, bo_lo, bar_index + 1, bo_lo, color=color.new(color.orange, 30), style=line.style_dashed)
    line.set_xy1(boH, bo_until - bo_W, bo_hi)
    line.set_xy2(boH, bar_index + 1, bo_hi)
    line.set_xy1(boL, bo_until - bo_W, bo_lo)
    line.set_xy2(boL, bar_index + 1, bo_lo)
else if not na(boH)
    line.delete(boH)
    line.delete(boL)
    boH := na
    boL := na

plotshape(show_dots and shape_ok, title="Жёлтая точка", style=shape.circle, location=location.belowbar, color=color.new(color.yellow, 20), size=size.tiny)

alertcondition(a_entry, "v5 вход", "Портфель: вход по системе v5")
alertcondition(not na(b_evt), "Пробой вход", "Портфель: вход по системе Пробой")

// ════════ ТАБЛИЦА ════════
f_sum(_Rv, _Rt, _days) =>
    s = 0.0
    nn = 0
    w = 0
    if array.size(_Rv) > 0
        for i = 0 to array.size(_Rv) - 1
            r = array.get(_Rv, i)
            if _days == 0 or time - array.get(_Rt, i) <= 1000 * 60 * 60 * 24 * _days
                s += r
                nn += 1
                w += r > 0 ? 1 : 0
    [s, nn, w]

tp_ = tbl_pos == "верх-право" ? position.top_right : tbl_pos == "верх-лево" ? position.top_left : tbl_pos == "низ-право" ? position.bottom_right : position.bottom_left
var table T = table.new(tp_, 4, 7, bgcolor=color.new(#000000, 12), border_width=1, border_color=color.new(color.gray, 70))
if barstate.islast
    hc = color.new(color.silver, 0)
    [a90, an90, aw90] = f_sum(Arv, Art, 90)
    [aAll, anAll, awAll] = f_sum(Arv, Art, 0)
    [b90, bn90, bw90] = f_sum(Brv, Brt, 90)
    [bAll, bnAll, bwAll] = f_sum(Brv, Brt, 0)
    table.cell(T, 0, 0, "ПОРТФЕЛЬ", text_color=color.white, text_size=size.small)
    table.cell(T, 1, 0, "90 дней", text_color=hc, text_size=size.small)
    table.cell(T, 2, 0, "всё (сделок)", text_color=hc, text_size=size.small)
    table.cell(T, 3, 0, "WR | нед", text_color=hc, text_size=size.small)
    table.cell(T, 0, 1, "A: v5 разворот", text_color=color.new(color.blue, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 1, (a90 >= 0 ? "+" : "") + str.tostring(a90, "#.#") + "R", text_color=a90 >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(T, 2, 1, (aAll >= 0 ? "+" : "") + str.tostring(aAll, "#.#") + "R (" + str.tostring(anAll) + ")", text_color=aAll >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(T, 3, 1, str.tostring(anAll > 0 ? awAll * 100 / anAll : 0, "#") + "% | " + (Awr >= 0 ? "+" : "") + str.tostring(Awr, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(T, 0, 2, "B: пробой импульс", text_color=color.new(color.teal, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 2, (b90 >= 0 ? "+" : "") + str.tostring(b90, "#.#") + "R", text_color=b90 >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(T, 2, 2, (bAll >= 0 ? "+" : "") + str.tostring(bAll, "#.#") + "R (" + str.tostring(bnAll) + ")", text_color=bAll >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(T, 3, 2, str.tostring(bnAll > 0 ? bwAll * 100 / bnAll : 0, "#") + "% | " + (Bwr >= 0 ? "+" : "") + str.tostring(Bwr, "#.#"), text_color=color.white, text_size=size.small)
    pAll = aAll + bAll
    p90 = a90 + b90
    table.cell(T, 0, 3, "ПОРТФЕЛЬ Σ", text_color=color.new(color.yellow, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 3, (p90 >= 0 ? "+" : "") + str.tostring(p90, "#.#") + "R", text_color=p90 >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(T, 2, 3, (pAll >= 0 ? "+" : "") + str.tostring(pAll, "#.#") + "R", text_color=pAll >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(T, 3, 3, "незав. кор+0.02", text_color=color.gray, text_size=size.small)
    table.cell(T, 0, 4, "Открыто A / B", text_color=hc, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 4, str.tostring(array.size(AE)) + " / " + str.tostring(array.size(BE)), text_color=color.white, text_size=size.small)
    table.cell(T, 2, 4, "пробой: " + (bo_pend and array.size(BE) == 0 ? "ждёт" : array.size(BE) > 0 ? "в позиции" : "—"), text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 3, 4, (v5_ws and Awr <= -3 ? "A стоп" : "") + (bo_ws and Bwr <= -3 ? " B стоп" : ""), text_color=color.new(color.red, 0), text_size=size.small)
    table.cell(T, 0, 5, "Правила v5", text_color=hc, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 5, (v5_ws ? "предохр✓" : "") + (v5_regf ? " БОК+L✓" : ""), text_color=color.new(color.aqua, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(T, 2, 5, "режим D3: " + (d3 == 1 ? "ВОСХ" : d3 == -1 ? "НИСХ" : "БОК"), text_color=d3 == 1 ? color.lime : d3 == -1 ? color.red : color.orange, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 3, 5, "", text_size=size.small)
    table.cell(T, 0, 6, "⚠ тонкие эджи", text_color=color.new(color.orange, 0), text_halign=text.align_left, text_size=size.small)
    table.cell(T, 1, 6, "наблюдение, не грааль", text_color=color.gray, text_halign=text.align_left, text_size=size.small)
    table.cell(T, 2, 6, "", text_size=size.small)
    table.cell(T, 3, 6, "", text_size=size.small)
